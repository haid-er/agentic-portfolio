# ---- Admin -------------------------------------------------------------
# Password for /admin/login.
ADMIN_PASSWORD=change-me
# Secret for the HMAC-signed session cookie. Use 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=

# ---- Saving content (GitHub Contents API) --------------------------------
# Fine-grained token: this repository only, permission "Contents: Read and write".
# Leave empty in local dev: admin then writes content/*.json on disk.
GITHUB_TOKEN=
GITHUB_REPO=haid-er/agentic-portfolio
GITHUB_BRANCH=main

# ---- AI providers (router order: Groq -> Gemini -> DeepSeek -> in-browser) ----
GROQ_API_KEY=
GEMINI_API_KEY=
# DeepSeek is PAID: disabled by default in content/ai.json; hard max_tokens + budget.
DEEPSEEK_API_KEY=
